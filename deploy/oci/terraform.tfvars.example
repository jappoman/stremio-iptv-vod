region = "eu-milan-1"
tenancy_ocid = "ocid1.tenancy.oc1..xxxx"
# compartment_ocid = ""        # leave empty for the root/tenancy
# availability_domain = ""     # empty = first available AD
shape = "VM.Standard.A1.Flex"
is_flexible = true
ocpus = 2
memory_in_gbs = 12
ssh_public_key = "ssh-ed25519 AAAA...  you@pc"
