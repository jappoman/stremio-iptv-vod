#!/usr/bin/env bash
# cloud-init: installs Docker, starts the addon, configures Caddy (HTTPS) and DuckDNS.
# Runs as root on first boot.
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update

# --- Docker ---
curl -fsSL https://get.docker.com | sh
usermod -aG docker ubuntu

# --- Firewall: the Oracle Ubuntu image accepts ONLY SSH and REJECTs the rest.
#     We open 80/443 (required by the Let's Encrypt challenge) and persist them. ---
echo 'iptables-persistent iptables-persistent/autosave_v4 boolean true' | debconf-set-selections
echo 'iptables-persistent iptables-persistent/autosave_v6 boolean true' | debconf-set-selections
apt-get install -y --no-install-recommends iptables-persistent
iptables -I INPUT -p tcp --dport 80 -j ACCEPT
iptables -I INPUT -p tcp --dport 443 -j ACCEPT
netfilter-persistent save

# --- Caddy: NOT in the default Ubuntu repos, needs the official Cloudsmith repo ---
apt-get install -y --no-install-recommends \
  debian-keyring debian-archive-keyring apt-transport-https curl
curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' \
  | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' \
  | tee /etc/apt/sources.list.d/caddy-stable.list >/dev/null
apt-get update
apt-get install -y --no-install-recommends caddy

# --- DuckDNS: detects the egress IP and passes it EXPLICITLY (DuckDNS's
#     auto-detect is not reliable), updates BEFORE starting Caddy, so the
#     Let's Encrypt challenge finds the right A record right away ---
cat > /usr/local/bin/duckdns-update.sh <<'DUCKEOF'
#!/usr/bin/env bash
IP=$(curl -4 -s --max-time 10 https://ifconfig.me || true)
[ -z "$IP" ] && exit 0
curl -fsS "https://www.duckdns.org/update?domains=${duckdns_domain}&token=${duckdns_token}&ip=$IP" -o /dev/null
DUCKEOF
chmod 700 /usr/local/bin/duckdns-update.sh
/usr/local/bin/duckdns-update.sh

cat > /etc/systemd/system/duckdns-update.service <<'SERVICEEOF'
[Unit]
Description=Update DuckDNS IP

[Service]
Type=oneshot
ExecStart=/usr/local/bin/duckdns-update.sh
SERVICEEOF

cat > /etc/systemd/system/duckdns-update.timer <<'TIMEREOF'
[Unit]
Description=Update DuckDNS IP every 5 minutes

[Timer]
OnBootSec=30s
OnUnitActiveSec=5m

[Install]
WantedBy=timers.target
TIMEREOF

systemctl daemon-reload
systemctl enable --now duckdns-update.timer

# --- Caddyfile + starting Caddy ---
cat > /etc/caddy/Caddyfile <<EOF
${duckdns_domain}.duckdns.org {
    reverse_proxy 127.0.0.1:7000
}
EOF
systemctl reload caddy || systemctl restart caddy

# --- Addon (GHCR image, must be public; multi-arch amd64+arm64) ---
docker pull ${image}
docker rm -f iptv-vod 2>/dev/null || true
docker run -d --name iptv-vod --restart unless-stopped \
  -p 127.0.0.1:7000:7000 ${image}

# --- Auto-update: watchtower 1.7.1 is incompatible with modern Docker
#     (API client 1.25 vs minimum 1.40) and is effectively abandoned. We
#     replace it with a systemd timer that re-pulls the GHCR image every
#     10 minutes and recreates the container if the digest changed.
#     The addon is stateless (config in the URL, in-memory cache): replacing
#     the container loses nothing. ---
cat > /usr/local/bin/iptv-vod-update.sh <<'UPDEOF'
#!/usr/bin/env bash
IMAGE="${image}"
CONTAINER="iptv-vod"
BEFORE=$(docker image inspect --format '{{index .RepoDigests 0}}' "$IMAGE" 2>/dev/null || echo none)
docker pull -q "$IMAGE" >/dev/null 2>&1 || true
AFTER=$(docker image inspect --format '{{index .RepoDigests 0}}' "$IMAGE" 2>/dev/null || echo none)
if [ "$BEFORE" != "$AFTER" ]; then
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  docker run -d --name "$CONTAINER" --restart unless-stopped -p 127.0.0.1:7000:7000 "$IMAGE" >/dev/null
fi
UPDEOF
chmod 700 /usr/local/bin/iptv-vod-update.sh

cat > /etc/systemd/system/iptv-vod-update.service <<'UPSERVICEEOF'
[Unit]
Description=Update the iptv-vod container when the GHCR image changes

[Service]
Type=oneshot
ExecStart=/usr/local/bin/iptv-vod-update.sh
UPSERVICEEOF

cat > /etc/systemd/system/iptv-vod-update.timer <<'UPTIMEREOF'
[Unit]
Description=Check iptv-vod updates every 10 minutes

[Timer]
OnBootSec=60s
OnUnitActiveSec=10m

[Install]
WantedBy=timers.target
UPTIMEREOF

systemctl daemon-reload
systemctl enable --now iptv-vod-update.timer
/usr/local/bin/iptv-vod-update.sh
